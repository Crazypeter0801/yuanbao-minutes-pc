{
  "name": "yuanbao-minutes-pc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "腾讯会议 PC 端 · 元宝纪要侧边栏（D2C 工程）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "npm run build && node scripts/build-single-html.mjs",
    "pack:code-layer": "node scripts/make-code-layer-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.14",
    "sass": "1.81.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
